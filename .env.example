# Copy this file to .env and fill in real values. Never commit .env.

# Gemini API key, used for fact extraction, adjudication and embeddings.
GEMINI_API_KEY=

# Model names (override if you have access to different ones).
GEMINI_EXTRACTION_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Local storage. Paths are relative to the repo root unless absolute.
DATABASE_PATH=data/facts.db
UPLOAD_DIR=data/uploads

# Where source PDFs are read from. Point this at your dataset folder; scripts
# also accept an explicit --input path, which takes precedence over this.
INPUT_DIR=data/input

# Require evidence spans to match the page character for character. Set false to
# forgive whitespace only (words and digits must still all be on the page).
REQUIRE_EXACT_SPANS=true

# Cap on thinking tokens per call. Too low starves the multi-column reasoning a
# dense table needs, and facts go missing. -1 lets the model decide.
THINKING_BUDGET=2048

# Seconds between model calls, to stay inside a per-minute quota.
REQUEST_DELAY_SECONDS=6.0

# Require a digit in the value of any fact that carries a unit.
REQUIRE_DIGIT_WITH_UNIT=true

# Browser origins allowed to call the API, comma separated. Defaults to the
# Vite dev server. Not a wildcard: only what is listed here is let through.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
